{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurochain.local/schemas/x402-service-boundary-v1.schema.json",
  "title": "NeuroChain x402 Service Boundary v1",
  "description": "Offline data contract between a future @x402/stellar facilitator/Bazaar service and the Rust NeuroChain guardrail runtime. It is not a network endpoint or an authority grant.",
  "oneOf": [
    {
      "$ref": "#/$defs/evaluationRequest"
    },
    {
      "$ref": "#/$defs/evaluationResponse"
    }
  ],
  "$defs": {
    "evaluationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "resource_id",
        "operation",
        "network",
        "intent_text"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "message_type": {
          "const": "evaluation_request"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation": {
          "const": "plan_and_evaluate"
        },
        "network": {
          "type": "string",
          "enum": [
            "stellar:testnet",
            "stellar:pubnet"
          ]
        },
        "intent_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "authorityGrants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payment_verification",
        "payment_settlement",
        "guardrail_override",
        "wallet_signing",
        "stellar_submission"
      ],
      "properties": {
        "payment_verification": {
          "const": false
        },
        "payment_settlement": {
          "const": false
        },
        "guardrail_override": {
          "const": false
        },
        "wallet_signing": {
          "const": false
        },
        "stellar_submission": {
          "const": false
        }
      }
    },
    "actionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "actions"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "kind"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        }
      }
    },
    "evaluationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "message_type",
        "request_id",
        "decision",
        "exit_code",
        "reason_code",
        "action_plan",
        "action_plan_hash",
        "authority_grants",
        "underlying_action_submit_allowed"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "message_type": {
          "const": "evaluation_response"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "requires_approval",
            "blocked"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            3,
            4,
            5,
            null
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action_plan": {
          "$ref": "#/$defs/actionPlan"
        },
        "action_plan_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_grants": {
          "$ref": "#/$defs/authorityGrants"
        },
        "underlying_action_submit_allowed": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": null
              },
              "reason_code": {
                "const": "approved"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "requires_approval"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": null
              },
              "reason_code": {
                "const": "approval_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "enum": [
                  3,
                  4,
                  5
                ]
              }
            }
          }
        }
      ]
    }
  }
}
